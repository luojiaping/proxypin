name: Android Build

on:
  push:
    branches: [ main, dev_mcp ]
  pull_request:
    branches: [ main ]

jobs:
  build-android:
    runs-on: ubuntu-latest
    env:
      FORCE_JAVASCRIPT_ACTIONS_TO_NODE24: "true"
    steps:
      - uses: actions/checkout@v4

      - name: Setup Java
        uses: actions/setup-java@v4
        with:
          distribution: temurin
          java-version: "17"

      - name: Setup Flutter
        uses: subosito/flutter-action@v2
        with:
          channel: stable

      - name: Flutter doctor
        run: flutter doctor -v

      - name: Install dependencies
        run: |
          for i in 1 2 3; do
            flutter pub get && break
            echo "Attempt $i failed, retrying in 10s..."
            sleep 10
          done

      - name: Analyze
        run: flutter analyze --no-fatal-infos --no-fatal-warnings

      - name: Create dummy keystore
        run: |
          keytool -genkeypair -v -keystore $HOME/debug.jks -keyalg RSA -keysize 2048 -validity 10000 -alias debug -storepass android -keypass android -dname "CN=CI,O=Test,L=Test,ST=Test,C=US"
          echo "storeFile=$HOME/debug.jks" > android/key.properties
          echo "storePassword=android" >> android/key.properties
          echo "keyAlias=debug" >> android/key.properties
          echo "keyPassword=android" >> android/key.properties

      - name: Build APK (debug)
        run: flutter build apk --debug

      - name: Upload APK
        uses: actions/upload-artifact@v4
        with:
          name: proxypin-debug-apk
          path: build/app/outputs/flutter-apk/app-debug.apk
          retention-days: 7
